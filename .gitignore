# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Pages deploy: the ephemeral _site artifact and the privately-fetched
# font staging dir are produced by scripts/build-pages-site.sh / pages.yml at
# deploy time (and on a local dry-run). Never committed.
_site/
_fonts_src/
# Specimen bundles are produced into _site/specimens/ at stage time; never
# commit a stray bundle written next to its entry.
specimens/**/*.bundle.js

# Test / coverage
coverage/
# Playwright run output (@qball-inc/elements browser tests)
test-results/
playwright-report/

# Consumer harness: packed tarballs + the fixture's standalone lockfile
# are regenerated by the validate-consumer*.sh scripts on every run; never committed.
*.tgz
fixtures/consumer/pnpm-lock.yaml
fixtures/consumer-astro/pnpm-lock.yaml
fixtures/consumer-astro/.astro/

# Environment
.env
.env.local
.env.*.local

# Editor / OS noise
.DS_Store
*.swp
.idea/
.vscode/

# Font binaries — NEVER commit (embed-in-deploy, never-in-source posture).
# Berkeley Mono is licensed and injected at deploy time only; the
# enforceable dual-assertion NFR1 gate (tarball + committed tree) is the
# belt-and-suspenders, clean-by-construction baseline.
*.woff2
*.woff
*.ttf
*.otf
*.eot
*.pfb
*.pfm
fonts/

# stray local design-handoff export — never commit to the public repo
/assets/Ashay Kubal Design System.zip
