{
  "name": "qball-design-system",
  "version": "0.0.0",
  "private": true,
  "description": "QBall Design System — @qball-inc/tokens + @qball-inc/react. Portable, versioned design tokens + a framework-agnostic React component library.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "typecheck": "pnpm -r exec tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter \"@qball-inc/*\" --if-present run test",
    "license-check": "bash scripts/license-check.sh",
    "consumer-validate": "bash fixtures/consumer/scripts/validate-consumer.sh",
    "ci": "pnpm typecheck && pnpm lint && pnpm test && pnpm run license-check && pnpm run consumer-validate"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
