{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Ashay Kubal Design System tokens — Style-Dictionary / DTCG shape. Generated from colors_and_type.css (canonical). Color tokens carry both light + dark values; consume via the mode that matches data-theme.",
  "$version": "1.0.0",
  "font": {
    "display": { "$type": "fontFamily", "$value": ["Fira Code", "SF Mono", "Cascadia Code", "monospace"], "$description": "H1–H2, tickers, prices, all numerics (tabular). Public default is Fira Code; intended face is Berkeley Mono (commercial, https://usgraphics.com) — restore per README." },
    "heading": { "$type": "fontFamily", "$value": ["Fira Code", "SF Mono", "Cascadia Code", "monospace"], "$description": "H3–H4, UI, nav, buttons, captions, metadata" },
    "body":    { "$type": "fontFamily", "$value": ["Syne", "Inter", "system-ui", "sans-serif"], "$description": "long-form body, 16px / 1.75" },
    "ui":      { "$type": "fontFamily", "$value": ["Fira Code", "SF Mono", "monospace"] },
    "quote":   { "$type": "fontFamily", "$value": ["Instrument Serif", "Georgia", "serif"], "$description": "pull quotes (italic), max 480px" },
    "code":    { "$type": "fontFamily", "$value": ["JetBrains Mono", "Fira Code", "SF Mono", "monospace"] }
  },
  "size": {
    "h1": { "$type": "dimension", "$value": "56px" },
    "h2": { "$type": "dimension", "$value": "36px" },
    "h3": { "$type": "dimension", "$value": "24px" },
    "h4": { "$type": "dimension", "$value": "18px" },
    "body": { "$type": "dimension", "$value": "16px" },
    "quote": { "$type": "dimension", "$value": "20px" },
    "code": { "$type": "dimension", "$value": "14px" },
    "caption": { "$type": "dimension", "$value": "12px" },
    "tag": { "$type": "dimension", "$value": "11px" },
    "button": { "$type": "dimension", "$value": "13px" }
  },
  "tracking": {
    "h1": { "$type": "dimension", "$value": "-2px" },
    "h2": { "$type": "dimension", "$value": "-1px" },
    "h3": { "$type": "dimension", "$value": "-0.5px" },
    "h4": { "$type": "dimension", "$value": "0px" },
    "body": { "$type": "dimension", "$value": "0px" },
    "caption": { "$type": "dimension", "$value": "1.25px", "$description": "uppercase eyebrow only" }
  },
  "color": {
    "bg":            { "$type": "color", "light": "#F7F3EE", "dark": "#1E1D1B", "$description": "page background — parchment / charcoal; never pure white/black" },
    "surface":       { "$type": "color", "light": "#EDE8E1", "dark": "#2A2826" },
    "fg":            { "$type": "color", "light": "#141414", "dark": "#E7E0D6" },
    "fg-secondary":  { "$type": "color", "light": "#57534E", "dark": "#A8A29E" },
    "fg-muted":      { "$type": "color", "light": "#78716C", "dark": "#78716C" },
    "signal":        { "$type": "color", "light": "#3F6B5B", "dark": "#5B9E87", "$description": "sage — ALL wayfinding (links, CTAs, active, focus)" },
    "highlight":     { "$type": "color", "light": "#B45309", "dark": "#D97706", "$description": "amber — featured/latest, secondary CTAs, [unverified]" },
    "error":         { "$type": "color", "light": "#991B1B", "dark": "#EF4444" },
    "success":       { "$type": "color", "light": "#3F6B5B", "dark": "#5B9E87" },
    "warning":       { "$type": "color", "light": "#B45309", "dark": "#D97706" },
    "info":          { "$type": "color", "light": "#78716C", "dark": "#A8A29E" },
    "border-default":{ "$type": "color", "light": "rgba(0,0,0,0.06)", "dark": "rgba(255,255,255,0.06)" },
    "border-strong": { "$type": "color", "light": "rgba(0,0,0,0.14)", "dark": "rgba(255,255,255,0.14)" },
    "signal-bg":     { "$type": "color", "light": "rgba(63,107,91,0.10)", "dark": "rgba(91,158,135,0.15)" },
    "highlight-bg":  { "$type": "color", "light": "rgba(180,83,9,0.10)", "dark": "rgba(217,119,6,0.15)" }
  },
  "data": {
    "$description": "finance/data palette — SEMANTICS ONLY (gains/losses/caution/info). Never wayfinding. Always pair with a non-color cue (arrow/sign/label).",
    "up":     { "$type": "color", "light": "#2E7D4F", "dark": "#4FB07A" },
    "down":   { "$type": "color", "light": "#B5342B", "dark": "#E2705F" },
    "warn":   { "$type": "color", "light": "#9A7D0F", "dark": "#D9B43C" },
    "info":   { "$type": "color", "light": "#2C6395", "dark": "#5B9BD6" },
    "flat":   { "$type": "color", "light": "#78716C", "dark": "#A8A29E" },
    "up-bg":  { "$type": "color", "light": "rgba(46,125,79,0.10)", "dark": "rgba(79,176,122,0.15)" },
    "down-bg":{ "$type": "color", "light": "rgba(181,52,43,0.10)", "dark": "rgba(226,112,95,0.15)" },
    "warn-bg":{ "$type": "color", "light": "rgba(154,125,15,0.12)", "dark": "rgba(217,180,60,0.16)" },
    "info-bg":{ "$type": "color", "light": "rgba(44,99,149,0.10)", "dark": "rgba(91,155,214,0.15)" }
  },
  "anno": {
    "$description": "grounding annotation — outside the finance palette so a cited [source] never reads as a price. Unverified uses the amber highlight.",
    "source":    { "$type": "color", "light": "#4E6577", "dark": "#93A7B5" },
    "source-bg": { "$type": "color", "light": "rgba(78,101,119,0.12)", "dark": "rgba(147,167,181,0.16)" }
  },
  "stage": {
    "$description": "QuBrain graph explorer dark stage — theme-INDEPENDENT (the explorer never follows the page theme). Consumed only by graph.css, which maps the ordinary tokens onto these inside the explorer. Two tiers: canvas (deep ink + brighter labels) and panel (entity panel, filter bar, details pill).",
    "bg":             { "$type": "color", "$value": "#12161F", "$description": "canvas deep-ink stage" },
    "surface":        { "$type": "color", "$value": "#1A1F2B" },
    "text-primary":   { "$type": "color", "$value": "#EDE8E1" },
    "text-secondary": { "$type": "color", "$value": "#D6D1C8" },
    "text-muted":     { "$type": "color", "$value": "#A8A29E" },
    "border":         { "$type": "color", "$value": "rgba(255,255,255,0.06)" },
    "border-strong":  { "$type": "color", "$value": "rgba(255,255,255,0.25)" },
    "panel-bg":             { "$type": "color", "$value": "#1E1D1B" },
    "panel-surface":        { "$type": "color", "$value": "#2A2826" },
    "panel-text-primary":   { "$type": "color", "$value": "#E7E0D6" },
    "panel-text-secondary": { "$type": "color", "$value": "#CDC6BB" },
    "panel-text-muted":     { "$type": "color", "$value": "#8A847D" },
    "panel-border":         { "$type": "color", "$value": "rgba(255,255,255,0.06)" },
    "panel-border-strong":  { "$type": "color", "$value": "rgba(255,255,255,0.14)" },
    "panel-divider":        { "$type": "color", "$value": "rgba(255,255,255,0.07)", "$description": "glass filter-strip hairline" },
    "mark":           { "$type": "color", "$value": "#E7E2DA", "$description": "QuBae launcher mascot ink over the stage" },
    "signal":         { "$type": "color", "$value": "#5B9E87" },
    "highlight":      { "$type": "color", "$value": "#D97706" },
    "signal-bg":      { "$type": "color", "$value": "rgba(91,158,135,0.15)" },
    "highlight-bg":   { "$type": "color", "$value": "rgba(217,119,6,0.15)" },
    "data-up":        { "$type": "color", "$value": "#4FB07A" },
    "data-down":      { "$type": "color", "$value": "#E2705F" },
    "data-warn":      { "$type": "color", "$value": "#D9B43C" },
    "data-info":      { "$type": "color", "$value": "#5B9BD6" },
    "data-flat":      { "$type": "color", "$value": "#A8A29E" },
    "data-up-bg":     { "$type": "color", "$value": "rgba(79,176,122,0.15)" },
    "data-down-bg":   { "$type": "color", "$value": "rgba(226,112,95,0.15)" },
    "data-warn-bg":   { "$type": "color", "$value": "rgba(217,180,60,0.16)" },
    "data-info-bg":   { "$type": "color", "$value": "rgba(91,155,214,0.15)" },
    "anno-source":    { "$type": "color", "$value": "#93A7B5" },
    "anno-source-bg": { "$type": "color", "$value": "rgba(147,167,181,0.16)" }
  },
  "scrim": {
    "light": { "$type": "color", "$value": "rgba(20,20,20,0.22)", "$description": "QuBae chat overlay scrim — dims the page less than a modal (--color-scrim-light)" }
  },
  "scale": {
    "text": { "$type": "number", "$value": 1, "$description": "--text-scale: multiplies QuBrain/QuBae component text sizes; 1 = as designed. Consumers stepping type up on wide screens set it to match (e.g. 1.25 at min-width 1600px)." }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "8px" },
    "lg": { "$type": "dimension", "$value": "12px", "$description": "max radius; pills (999px) are off-brand" }
  },
  "space": {
    "xs":  { "$type": "dimension", "$value": "4px" },
    "sm":  { "$type": "dimension", "$value": "8px" },
    "md":  { "$type": "dimension", "$value": "16px" },
    "lg":  { "$type": "dimension", "$value": "32px" },
    "xl":  { "$type": "dimension", "$value": "64px" },
    "2xl": { "$type": "dimension", "$value": "128px" }
  },
  "width": {
    "body":  { "$type": "dimension", "$value": "720px" },
    "page":  { "$type": "dimension", "$value": "1200px" },
    "code":  { "$type": "dimension", "$value": "800px" },
    "quote": { "$type": "dimension", "$value": "480px" }
  },
  "motion": {
    "ease-out":    { "$type": "cubicBezier", "$value": [0.22, 1, 0.36, 1] },
    "ease-in-out": { "$type": "cubicBezier", "$value": [0.65, 0, 0.35, 1] },
    "duration-fast": { "$type": "duration", "$value": "120ms" },
    "duration-base": { "$type": "duration", "$value": "200ms" },
    "duration-slow": { "$type": "duration", "$value": "360ms" }
  }
}
